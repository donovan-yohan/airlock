{
  "listen": "127.0.0.1:8788",
  "state_dir": "../../.local/state/airlock/trusted",
  "control_socket": "../../.local/state/airlock/trusted/control.sock",
  "private_key_file": "trusted.key",
  "requester_url": "https://requester-node.example.invalid",
  "github_cli_path": "/usr/bin/gh",
  "github_config_dir": "../../.local/state/airlock/gh-config",
  "sandbox_cli_path": "/usr/bin/bwrap",
  "execution_timeout": "30s",
  "profile_config_version": "example-2026-08",
  "credential_authority_label": "Broad GitHub credential authority",
  "execution_identity_label": "Dedicated trusted Airlock service account",
  "sandbox_label": "Linux bubblewrap namespaces with an ephemeral private GitHub config and working directory",
  "network_label": "Outbound network available to the approved GitHub CLI process",
  "cwd_label": "Fresh private per-invocation directory",
  "output_label": "Bounded sanitized stdout and stderr preview for trusted reviewers only; no requester egress",
  "poll_interval": "2s",
  "request_max_ttl": "15m",
  "catalog_ttl": "1h",
  "receipt_ttl": "24h",
  "allowed_logins": [
    "reviewer@example.invalid"
  ],
  "capabilities": [
    {
      "id": "github:example-owner",
      "display_name": "Example GitHub authority",
      "adapter": "github.repo.add_collaborator/v1",
      "owner": "example-owner",
      "collaborator": "example-agent",
      "permissions": [
        "pull",
        "push"
      ]
    }
  ]
}
