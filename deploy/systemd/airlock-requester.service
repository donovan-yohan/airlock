[Unit]
Description=Airlock requester node
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/airlock requester serve --config %h/.config/airlock/requester.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# Capability-changing hardening such as PrivateDevices= and
# CapabilityBoundingSet= can fail an unprivileged user unit before ExecStart
# with 218/CAPABILITIES. The dedicated account plus NoNewPrivileges and the
# remaining namespace/syscall restrictions prevent privilege gain.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/airlock/requester
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
